#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/pointing.h>

#define default_layer 0
#define lower_layer 1
#define raise_layer 2
#define adjust_layer 3
#define extra_layer 4


/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
// Home Row Mods (tap=letter, hold=modifier)
// Left                             Right
// |  Q  |  W  |  E  |  R  |  T  | |  Y  |  U  |  I  |  O  |  P    |
// | A_LC| S_LS| D_LA| F_LG|  G  | |  H  | J_RG| K_RA| L_RS| ;_RC  |
// |  Z  |  X  |  C  |  V  |  B  | |  N  |  M  |  ,  |  .  |  /    |
// | ESC | LOW | SPC |            | | ENT | RAI | BSPC |
            bindings = <
&kp Q      &kp W      &kp E      &kp R      &kp T           &kp Y      &kp U      &kp I      &kp O      &kp P
&mt LCTRL A &mt LSHFT S &mt LALT D &mt LGUI F &kp G         &kp H      &mt RGUI J &mt RALT K &mt RSHFT L &mt RCTRL SEMI
&kp Z      &kp X      &kp C      &kp V      &kp B           &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH
&kp ESC    &mo 1      &kp SPACE                             &kp BSPC   &mo 2      &kp RET
            >;
        };

        lower_layer {
            display-name = "Lower";
// Numbers + Symbols
// Left                             Right
// |  `   |  1  |  2  |  3  |  4  | |  5  |  6  |  7  |  8  |  9    |
// |  0   |  !  |  @  |  #  |  $  | |  %  |  ^  |  &  |  *  |  (    |
// |  )   |  -  |  =  |  [  |  ]  | |  \  |  '  |  "  |     |       |
// |      |     |      |            | |     |     | DEL  |
            bindings = <
&kp GRAVE &kp N1   &kp N2   &kp N3   &kp N4      &kp N5   &kp N6   &kp N7   &kp N8   &kp N9
&kp N0    &kp EXCL &kp AT   &kp HASH &kp DOLLAR  &kp PRCNT &kp CARET &kp AMPS &kp ASTRK &kp LPAR
&kp RPAR  &kp MINUS &kp EQUAL &kp LBKT &kp RBKT &kp BSLH  &kp SQT  &kp DQT  &trans   &trans
&trans    &trans   &trans                        &kp DEL  &trans   &trans
            >;
        };

        raise_layer {
            display-name = "Raise";
// Navigation + F-keys + Bluetooth
// Left                             Right
// | ADJ  | BT1 | BT2 | BT3 | BT4 | | BT5 |  F7 |  F8 |  F9 | F10   |
// | Tab  | F1  | F2  | F3  | F4  | | F5  |  F6 | F11 | F12 |       |
// |      |     |     |     |     | |     |  ←  |  ↓  |  ↑  |  →    |
// | BTCLR|     |      |            | |     |     |      |
            bindings = <
&mo 4          &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3    &bt BT_SEL 4 &kp F7    &kp F8    &kp F9    &kp F10
&kp TAB        &kp F1       &kp F2       &kp F3       &kp F4          &kp F5       &kp F6    &kp F11   &kp F12   &trans
&trans         &trans       &trans       &trans       &trans          &trans       &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT
&bt BT_CLR_ALL &trans       &trans                                   &trans       &trans    &trans
            >;
        };

        extra_layer {
            display-name = "Extra";
// Media + Mouse
// Left                             Right
// |      |     |     |     |     | |     | V_UP|     |     |       |
// |      | PREV| PLAY| NEXT|     | |     | V_DN| MUTE|     |       |
// |      |     |     |     |     | |     |     |     |     |       |
// |      |     |      |            | |     |     |     |
            bindings = <
&trans       &trans       &trans            &trans            &trans             &trans       &kp C_VOL_UP &trans    &trans    &trans
&trans       &kp C_PREV   &kp C_PLAY_PAUSE  &kp C_NEXT        &trans             &trans       &kp C_VOL_DN &kp C_MUTE &trans    &trans
&trans       &trans       &trans            &trans            &trans             &trans       &trans       &trans    &trans    &trans
&trans       &trans       &trans                                                 &trans       &trans       &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
// System
// Left                             Right
// |      |     |     |     |     | |     |     |     |     |       |
// |      |     |     |     |     | |     |     |     |     |       |
// |      |EP_ON|EP_OFF|EP_TOG|   | |     |     |     |     |       |
// |      |     |      |            | |     |     |     |
            bindings = <
&trans    &trans            &trans             &trans             &trans             &trans    &trans    &trans    &trans    &trans
&trans    &trans            &trans             &trans             &trans             &trans    &trans    &trans    &trans    &trans
&trans    &ext_power EP_ON  &ext_power EP_OFF  &ext_power EP_TOG  &trans             &trans    &trans    &trans    &trans    &trans
&trans    &trans            &trans                                                  &trans    &trans    &trans
            >;
        };
    };
};
